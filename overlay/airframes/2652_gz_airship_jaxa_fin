#!/bin/sh
#
# @name JAXA 14 m LTA Test Vehicle (Fins)
#
# @type Airship
# @class Airship
#
# @maintainer Hyunduk Shin <hyunduk@icarus-airship.com>
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=airship_jaxa_fin}

. ${R}etc/init.d-posix/airframes/2650_gz_airship_jaxa_rigid

# Yaw loop values from airship_gains.py (px4-airship-tools) for this hull
# Fin lift damps yaw: the generic fin member's feedforward scaled by the fins'
# held-turn slope over the yaw authority (4.34 against the generic 4.24 per m/s)
param set-default AS_YAWRATE_FF 0.307

# Fin lift damps yaw with the forward speed: a held turn takes 4.34 more
# normalized yaw torque per rad/s for each m/s over the pods' 192 N m (measured
# in held turns in the simulator). Scheduled on the ground speed with no wind
# bound, since the world has none, and capped where the pods can hold the turn;
# the ramp ends where the cap meets 0.8 of the yaw rate that stalls the fins in
# a turn (4.28 deg/s at 3.2 m/s) and starts at half that
param set-default AS_SPD_SRC 2
param set-default AS_SPD_WMAX 0
param set-default AS_SPD_HI 3.2
param set-default AS_YR_FF_SLP 4.34
