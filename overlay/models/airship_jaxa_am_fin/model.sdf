<?xml version="1.0" encoding="UTF-8"?>
<!--
  The vectored airship with fluid added mass and its fins lifting:
  airship_jaxa_am merged, plus the same four lift-drag plugins as
  airship_jaxa_fin. This is the pair that belongs together. Added mass brings
  the Munk moment, the destabilising couple (m_y - m_x) u v that makes a bare
  hull want to fly sideways, and the fins are sized to restore at least
  1.2 x that at every speed on the attached-flow slope
  (airship_jaxa_base_rigid's header); the plugins carry the plate secant, 1.36
  x. This model exists to show it.
-->
<sdf version="1.10">
  <model name="airship_jaxa_am_fin">
    <include merge="true">
      <uri>model://airship_jaxa_am</uri>
    </include>
    <!-- The four fins as lifting surfaces, one lift-drag plugin each, on the
         planform airship_jaxa_base_rigid draws and its header sizes. The
         plugin reads the velocity at <cp> (worldLinVel + worldAngVel x cp) and
         applies the force there, so no arm terms are needed. Basis, per fin: a
         1.50 m chord; the dorsal and side fins 2.45 m of exposed span, the
         ventral 1.86 m. Each fin with its mirror image has AR_j = 2
         span / chord (3.267 and 2.480), the flat-plate slope 2 pi
         AR / (AR + 2) (3.897 and 3.478 per rad; Ananda, Sukumar and Selig
         2015, a secant to about 10 deg), times the slender-body carryover
         (1 + r/s)^2 with r the hull radius at the mid-chord station (1.0896)
         and s the root plus the span (3.540 and 2.950; NACA Report 1307 eqs.
         14 and 21): cla = 6.666 and 6.523 per rad on the exposed area. cp at
         the quarter chord (x = -5.4950) on each fin's span centre. <upward> is
         the lift direction, normal to the fin's plane. Drag is the plugin's
         linear-in-alpha form, cda sized to the induced drag CL^2 / (pi AR e)
         with e = 0.9 at the lower of 10 deg and the stall (the stall here),
         since past the stall the plugin uses cda_stall. A fin stalls where its
         own incidence, the body angle times the hull's upwash K_W(B) (1.260
         and 1.319), reaches the plates' CLmax of 0.7, the top of the 0.55-0.7
         the same data measured: alpha_stall 0.1425 and 0.1526 rad of body
         angle. Past it cl falls to 0 and cd rises to a broadside plate's 1.2
         at 90 deg. The plugin stalls on the geometric incidence alone and
         applies nothing when the flow at cp comes from behind
         (forward . v <= 0), so these fins are absent in reverse flight and
         pure lateral drift. The fins' own added mass is not modelled. All of
         it is an estimate with a stated basis, not a measurement. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_port -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-5.4950 2.3146 3.0000</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>3.675</area>
      <a0>0</a0>
      <cla>6.666</cla>
      <cda>0.6857</cda>
      <cma>0</cma>
      <alpha_stall>0.1425</alpha_stall>
      <cla_stall>-0.6652</cla_stall>
      <cda_stall>0.7718</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_starboard -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-5.4950 -2.3146 3.0000</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <area>3.675</area>
      <a0>0</a0>
      <cla>6.666</cla>
      <cda>0.6857</cda>
      <cma>0</cma>
      <alpha_stall>0.1425</alpha_stall>
      <cla_stall>-0.6652</cla_stall>
      <cda_stall>0.7718</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_top -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-5.4950 0.0000 5.3146</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>3.675</area>
      <a0>0</a0>
      <cla>6.666</cla>
      <cda>0.6857</cda>
      <cma>0</cma>
      <alpha_stall>0.1425</alpha_stall>
      <cla_stall>-0.6652</cla_stall>
      <cda_stall>0.7718</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <!-- fin_bottom -->
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <cp>-5.4950 0.0000 0.9804</cp>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <area>2.790</area>
      <a0>0</a0>
      <cla>6.523</cla>
      <cda>0.9256</cda>
      <cma>0</cma>
      <alpha_stall>0.1526</alpha_stall>
      <cla_stall>-0.7016</cla_stall>
      <cda_stall>0.7466</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
  </model>
</sdf>
