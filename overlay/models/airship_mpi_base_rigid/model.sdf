<?xml version="1.0" encoding="UTF-8"?>
<!--
  MPI 5 m blimp base body: hull, gondola, tail and sensors; propulsion is
  added by wrapper models. Neutrally buoyant in the lta world, whose Buoyancy
  plugin sets the fluid density and must name this model to reach it: the
  collision volumes total 10.4854 m^3, so lift at 1.225 kg/m^3 is exactly the
  declared 12.8446 kg total (hull 3.43 + fins 1.37 + gondola 7.74 + pods/props
  0.3). The hull is one prolate spheroid of fineness 2.5, 5.00 x 2.00 m, drawn
  and collided alike: its 10.472 m^3 is what the buoyancy, the added mass, the
  Munk moment, the drag reference and the tail are all sized on. The gondola's
  top meets the envelope: along its centre line it sits -7.5 to -5.1 cm
  inside, and its long edges 5.5 to 7.8 cm below it. The centre of mass
  (0.000, 0, 0.5591) m sits under the centre of volume (0.000, 0, 1.249),
  429.1 mm above the pods' plane.

  The tail is a sizing, not a drawing: a cruciform of 0.85 m chord, trailing
  edge 0.14 m short of the stern at x = -2.360, roots on the hull at the
  mid-chord radius 0.633 m. The ventral fin is 0.56 m, what the ground allows
  at level attitude: its tip is 6 cm above the gondola floor, which 1.3 deg of
  nose-up on the ground uses up. The fins have no collision, so the simulation
  never touches; a vehicle built to this needs a stated ground pitch. The
  dorsal and side fins are 1.32 m, the shortest that meets the requirement
  (NACA Report 184): the dorsal and ventral fins restore at least 1.2 x the
  hull's potential-flow Munk moment at every speed, judged at zero sideslip on
  the attached-flow slope (Helmbold's) times the slender-body carryover of
  NACA Report 1307: 9.33 against 7.77 N m per (m/s)^2 of u v, a ratio of 1.20.
  The plugins carry the flat-plate slope 2 pi AR / (AR + 2) that Ananda,
  Sukumar and Selig (2015) measured, a secant to about 10 deg that includes
  vortex lift (1.40 on it). The side fins make pitch stable at every speed
  (1.83 on the same basis) with the pendulum on top. A fin stalls where its
  own incidence, the body angle times the hull's upwash K_W(B), reaches the
  plates' CLmax of 0.7 (8.2 deg of body angle), and flaps of 35 % chord would
  travel +-8 deg, the most that keeps a full-rudder turn on the added-mass
  plants 2 deg below that. The margin rests on the 0.7: at the 0.55 bottom of
  the measured range the same turn is at 90 % of the stall. Here the fins are
  visual only, in the inertia at 0.36 kg/m^2; airship_mpi_fin and
  airship_mpi_am_fin give them lift. A box on a tapering stern sits inside the
  hull at the leading edge and off it at the trailing edge. The gondola sits
  0.344 m forward so that the fins' mass leaves the centre of mass under the
  centre of volume. Added mass is not modeled here: airship_mpi_base_am is
  this file plus the <fluid_added_mass> block, and airship_mpi_drag adds hull
  drag and rotational damping.
-->
<sdf version="1.10">
  <model name="airship_mpi_base_rigid">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Hull as a solid spheroid (3.4325 kg at the hull centre), gondola
             box (7.74 kg at x 0.3438), four fin plates at their centres
             (dorsal and side 0.4007 kg, ventral 0.1700 kg), parallel-axis
             about the combined CoM, products included; pods/props carry their
             own mass in the wrapper, on the pods' plane. -->
        <pose>0.0005 0.0000 0.5694 0 0 0</pose>
        <mass>12.5446</mass>
        <inertia>
          <ixx>8.1715</ixx>
          <iyy>16.5512</iyy>
          <izz>12.6989</izz>
          <ixy>0.0000</ixy>
          <ixz>3.7583</ixz>
          <iyz>0.0000</iyz>
        </inertia>
      </inertial>
      <!-- The hull, drawn and collided alike; buoyancy volume 10.472 m^3 -->
      <collision name="hull_collision">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>2.50000 1.00000 1.00000</radii>
          </ellipsoid>
        </geometry>
      </collision>
      <!-- Ground contact; buoyancy volume 0.01344 m^3 -->
      <collision name="gondola_collision">
        <pose>0.3438 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.42 0.16 0.2</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name="hull_visual">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>2.50000 1.00000 1.00000</radii>
          </ellipsoid>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.85 0.85 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="gondola_visual">
        <pose>0.3438 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.42 0.16 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Cruciform tail, visual only here: no collision and no lift-drag,
           so it adds no weathercock stiffness. The _fin variants give these
           four boxes lift and airship_fixed_rigid gives them flaps. Rooted at the
           mid-chord hull radius; see the header. -->
      <visual name="fin_port_visual">
        <pose>-1.9350 1.2932 1.2500 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 1.32 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_starboard_visual">
        <pose>-1.9350 -1.2932 1.2500 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 1.32 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_top_visual">
        <pose>-1.9350 0.0000 2.5432 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 0.02 1.32</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_bottom_visual">
        <pose>-1.9350 0.0000 0.3368 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 0.02 0.56</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- 3mgauss RMS = 3e-7 tesla, noise modeled after IIS2MDC -->
          <!-- Noise is in the units of the field: tesla with use_units_gauss=false (lta.sdf's Magnetometer
               system, as PX4's gz_bridge server.config), gauss with the gz-sim default -->
          <x>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653, 0.05 deg/s in rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653, 0.65/0.70 mg-rms in m/s^2 -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
