<?xml version="1.0" encoding="UTF-8"?>
<!--
  airship_indoor_base_rigid with the hull's fluid added mass. A full copy of that file
  rather than a merge include of it, because <fluid_added_mass> is a property
  of base_link's <inertial>, which a plain merge include cannot change. The
  body, its mass budget, the tail sizing and the gondola offset are
  documented in airship_indoor_base_rigid's header. This file differs from it by the
  <fluid_added_mass> block, its model name and this header; an edit to either
  file belongs in both. The _am members of the generic vehicles merge this
  instead of airship_indoor_base_rigid.
-->
<sdf version="1.10">
  <model name="airship_indoor_base_am">
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Hull as a solid spheroid (0.5491 kg at the hull centre), gondola
             box (0.2 kg at x 0.1990), four fin plates at their centres (dorsal
             and side 0.0143 kg, ventral 0.0044 kg), parallel-axis about the
             combined CoM, products included; pods/props carry their own mass
             in the wrapper, on the pods' plane. -->
        <pose>0.0001 0.0000 0.3438 0 0 0</pose>
        <mass>0.7964</mass>
        <inertia>
          <ixx>0.0769</ixx>
          <iyy>0.2013</iyy>
          <izz>0.1785</izz>
          <ixy>0.0000</ixy>
          <ixz>0.0219</ixz>
          <iyz>0.0000</iyz>
        </inertia>
        <!-- Fluid added mass of the hull: Lamb's prolate-spheroid values for
             its fineness a/b = 2.5: k1 0.15626 axial, k2 0.76189 transverse,
             k' 0.36520 rotational, on the displaced mass rho V = 0.8210 kg of
             the spheroid with semi-axes a = 1.00000 m and b = 0.40000 m (the
             collision, which is also what is drawn) and its transverse inertia
             rho V (a^2 + b^2) / 5 = 0.1905 kg m^2. Written about the link
             origin, h = 0.44 m below the hull axis, with the offset terms that
             implies (xq = h m_x, yp = -h m_y, pp = h^2 m_y, qq = I_q + h^2
             m_x; T = 1/2 v_P^T A v_P with v_P = v_O + w x d). The engine folds
             this into the spatial inertia, Coriolis terms and all, so it
             brings the Munk moment with it: -(m_y - m_x) u v = -0.497 u v N m
             of yaw in this y-port, z-up frame, the nose turning away from the
             velocity. That is what the fins of the _fin members are sized
             against. The fin plates' own added mass is not in it. -->
        <fluid_added_mass>
          <xx>0.12829</xx>
          <yy>0.62551</yy>
          <zz>0.62551</zz>
          <xq>0.05645</xq>
          <yp>-0.27523</yp>
          <pp>0.12110</pp>
          <qq>0.09440</qq>
          <rr>0.06956</rr>
        </fluid_added_mass>
      </inertial>
      <!-- The hull, drawn and collided alike; buoyancy volume 0.670206 m^3 -->
      <collision name="hull_collision">
        <pose>0 0 0.44 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>1.00000 0.40000 0.40000</radii>
          </ellipsoid>
        </geometry>
      </collision>
      <!-- Ground contact; buoyancy volume 0.0003 m^3 -->
      <collision name="gondola_collision">
        <pose>0.1990 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.06 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name="hull_visual">
        <pose>0 0 0.44 0 0 0</pose>
        <geometry>
          <ellipsoid>
            <radii>1.00000 0.40000 0.40000</radii>
          </ellipsoid>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.85 0.85 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="gondola_visual">
        <pose>0.1990 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.06 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- Cruciform tail, visual only here: no collision and no lift-drag,
           so it adds no weathercock stiffness. The _fin variants give these
           four boxes lift and airship_fixed_rigid gives them flaps. Rooted at the
           mid-chord hull radius; see the header. -->
      <visual name="fin_port_visual">
        <pose>-0.8400 0.5420 0.4400 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.65 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_starboard_visual">
        <pose>-0.8400 -0.5420 0.4400 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.65 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_top_visual">
        <pose>-0.8400 0.0000 0.9820 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.01 0.65</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="fin_bottom_visual">
        <pose>-0.8400 0.0000 0.1230 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.01 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.2 0.2 1</ambient>
          <diffuse>0.6 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- 3mgauss RMS = 3e-7 tesla, noise modeled after IIS2MDC -->
          <!-- Noise is in the units of the field: tesla with use_units_gauss=false (lta.sdf's Magnetometer
               system, as PX4's gz_bridge server.config), gauss with the gz-sim default -->
          <x>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653, 0.05 deg/s in rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653, 0.65/0.70 mg-rms in m/s^2 -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
