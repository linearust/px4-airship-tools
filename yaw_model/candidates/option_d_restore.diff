 /**
+ * The yaw stick left the centre band this cycle: the rate setpoint is not zero
+ * and was zero on the previous closed-loop cycle. Zero is exact, so the
+ * comparisons need no epsilon: inside the band math::deadzone() returns
+ * out * (fabsf(x) > dzc), and yawRateSetpoint() scales that 0. They are
+ * written as fabsf(x) > 0.f for -Wfloat-equal.
+ */
+inline bool yawStickDeflected(float yaw_rate_sp, float yaw_rate_sp_prev)
+{
+	return fabsf(yaw_rate_sp) > 0.f && !(fabsf(yaw_rate_sp_prev) > 0.f);
+}
+
+/**
+ * The yaw stick came back into the centre band this cycle, or crossed it
+ * between two samples. A crossing counts only with a deadzone: without one a
+ * stick that dithers about the centre would change sign on every sample, and
+ * with MAN_DEADZONE 0 only an exactly centred stick is a release.
+ */
+inline bool yawStickReleased(float yaw_rate_sp, float yaw_rate_sp_prev, float deadzone)
+{
+	return (!(fabsf(yaw_rate_sp) > 0.f) && fabsf(yaw_rate_sp_prev) > 0.f)
+	       || (deadzone > 0.f && yaw_rate_sp * yaw_rate_sp_prev < 0.f);
+}
+
+/**
+ * Keep the yaw integrator's stick-centred value across a stick deflection.
+ *
+ * With the stick centred the yaw integrator holds the steady yaw torque that
+ * keeps the hull at zero rate (wind, a thrust or buoyancy asymmetry). While
+ * the stick turns the hull it also comes to hold the torque the turn needs
+ * against the hull's yaw damping. That part is I times the heading the hull
+ * lags the integrated setpoint by, so left in place after a release it turns
+ * the hull on by that heading (about 60 degrees after a half-stick turn of
+ * the damped vectored hull at AS_YAWRATE_I 0.09) before it unwinds. So the
+ * integrator is saved as the stick leaves the centre band
+ * (yawStickDeflected()), before the loop runs on the new setpoint, and put
+ * back as the stick returns to the band or crosses it (yawStickReleased());
+ * a crossing puts back the value saved at the first deflection. The write
+ * goes through RateControl::setIntegral(), within the integrator limit.
+ *
+ * The loop clears its integrator whenever it opens; reset() keeps this in
+ * step with it.
+ */
+class YawIntegratorHold
+{
+public:
+	/** What update() did this cycle */
+	enum class Event { None, Deflected, Released };
+
+	/**
+	 * One closed-loop cycle, before the rate controller runs
+	 * @param yaw_rate_sp this cycle's yaw rate setpoint [rad/s], from yawRateSetpoint()
+	 * @param deadzone MAN_DEADZONE, as yawStickReleased() reads it
+	 * @param rate_control the controller whose yaw integrator is saved and put back
+	 */
+	Event update(float yaw_rate_sp, float deadzone, RateControl &rate_control)
+	{
+		Event event = Event::None;
+
+		if (yawStickDeflected(yaw_rate_sp, _yaw_rate_sp_prev)) {
+			_centred = rate_control.getIntegral(kYawAxis);
+			event = Event::Deflected;
+
+		} else if (yawStickReleased(yaw_rate_sp, _yaw_rate_sp_prev, deadzone)) {
+			rate_control.setIntegral(kYawAxis, _centred);
+			event = Event::Released;
+		}
+
+		_yaw_rate_sp_prev = yaw_rate_sp;
+		return event;
+	}
+
+	/** The loop opened and its integrator was cleared: start from zero with it */
+	void reset()
+	{
+		_yaw_rate_sp_prev = 0.f;
+		_centred = 0.f;
+	}
+
+private:
+	static constexpr size_t kYawAxis = 2;
+
+	float _yaw_rate_sp_prev{0.f};	///< yaw rate setpoint of the previous closed-loop cycle [rad/s]
+	float _centred{0.f};		///< the yaw integrator when the stick last left the centre band
+};
+
+/**
  * Whether the pilot is in command: armed with valid manual input.
  *
  * The sticks stay live in every armed mode; lost or never-published input
