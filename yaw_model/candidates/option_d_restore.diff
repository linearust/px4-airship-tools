+TEST(AirshipManualInputTest, StickEventsAreTheDeadzoneEdges)
+{
+	const float out = yawRateSetpoint(0.5f, kDeadzone, kMaxRate);
+	const float in = yawRateSetpoint(0.05f, kDeadzone, kMaxRate);
+	const float back = yawRateSetpoint(-0.5f, kDeadzone, kMaxRate);
+
+	EXPECT_TRUE(yawStickDeflected(out, in));
+	EXPECT_FALSE(yawStickDeflected(out, out));
+	EXPECT_FALSE(yawStickDeflected(in, in));
+	EXPECT_TRUE(yawStickReleased(in, out, kDeadzone));
+	EXPECT_FALSE(yawStickReleased(in, in, kDeadzone));
+	EXPECT_FALSE(yawStickReleased(out, out, kDeadzone));
+	// a reversal that skips the band is a release, and not a new deflection
+	EXPECT_TRUE(yawStickReleased(back, out, kDeadzone));
+	EXPECT_FALSE(yawStickDeflected(back, out));
+	// the band edge itself is centred
+	EXPECT_TRUE(yawStickReleased(yawRateSetpoint(-kDeadzone, kDeadzone, kMaxRate), back, kDeadzone));
+	// without a deadzone a sign change is dither about the centre, not a release
+	EXPECT_FALSE(yawStickReleased(yawRateSetpoint(-0.001f, 0.f, kMaxRate), yawRateSetpoint(0.001f, 0.f, kMaxRate), 0.f));
+	EXPECT_TRUE(yawStickReleased(yawRateSetpoint(0.f, 0.f, kMaxRate), yawRateSetpoint(0.001f, 0.f, kMaxRate), 0.f));
+}
+
+/** The yaw rate controller as the module configures it, AS_YAWRATE_I and AS_YR_INT_LIM at their defaults */
+static RateControl yawRateLoop()
+{
+	RateControl rate_control;
+	rate_control.setPidGains(matrix::Vector3f{}, matrix::Vector3f{0.f, 0.f, 0.09f}, matrix::Vector3f{});
+	rate_control.setIntegratorLimit(matrix::Vector3f{0.f, 0.f, 0.3f});
+	return rate_control;
+}
+
+/**
+ * Closed-loop cycles with the stick held at yaw_rate_sp and the hull turning at
+ * rate, in the module's order: the hold first, then the loop. The stick does
+ * not move, so the hold sees no event; the rate error winds the integrator.
+ */
+static void holdStick(YawIntegratorHold &hold, RateControl &rate_control, float yaw_rate_sp, float rate, int cycles)
+{
+	for (int i = 0; i < cycles; i++) {
+		EXPECT_EQ(hold.update(yaw_rate_sp, kDeadzone, rate_control), YawIntegratorHold::Event::None);
+		rate_control.update(matrix::Vector3f{0.f, 0.f, rate}, matrix::Vector3f{0.f, 0.f, yaw_rate_sp}, matrix::Vector3f{},
+				    0.004f, false);
+	}
+}
+
+TEST(AirshipManualInputTest, YawIntegratorReturnsToItsCentredValueOnRelease)
+{
+	using Event = YawIntegratorHold::Event;
+	RateControl rate_control = yawRateLoop();
+	YawIntegratorHold hold;
+	const float centred = yawRateSetpoint(0.f, kDeadzone, kMaxRate);
+	const float right = yawRateSetpoint(0.5f, kDeadzone, kMaxRate);
+	const float left = yawRateSetpoint(-0.5f, kDeadzone, kMaxRate);
+
+	// centred, the hull drifting left: the integrator winds to the torque that holds it
+	holdStick(hold, rate_control, centred, -0.1f, 250);
+	const float held = rate_control.getIntegral(2);
+	EXPECT_GT(held, 0.f);
+
+	// the stick leaves the band: the value is saved before the loop runs on the new setpoint
+	EXPECT_EQ(hold.update(right, kDeadzone, rate_control), Event::Deflected);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), held);
+
+	// through the turn the hull lags the setpoint and the integrator winds on; the saved value does not follow
+	holdStick(hold, rate_control, right, 0.f, 250);
+	EXPECT_GT(rate_control.getIntegral(2), held);
+
+	// back in the band: the centred value is put back, once
+	EXPECT_EQ(hold.update(centred, kDeadzone, rate_control), Event::Released);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), held);
+	holdStick(hold, rate_control, centred, 0.f, 1);
+
+	// a reversal across the band puts it back too, keeping the value of the first deflection
+	EXPECT_EQ(hold.update(right, kDeadzone, rate_control), Event::Deflected);
+	holdStick(hold, rate_control, right, 0.f, 250);
+	EXPECT_EQ(hold.update(left, kDeadzone, rate_control), Event::Released);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), held);
+	holdStick(hold, rate_control, left, 0.f, 250);
+	EXPECT_LT(rate_control.getIntegral(2), held);
+	EXPECT_EQ(hold.update(centred, kDeadzone, rate_control), Event::Released);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), held);
+}
+
+TEST(AirshipManualInputTest, YawIntegratorHoldStartsFromZeroWithTheLoop)
+{
+	using Event = YawIntegratorHold::Event;
+	RateControl rate_control = yawRateLoop();
+	YawIntegratorHold hold;
+	const float centred = yawRateSetpoint(0.f, kDeadzone, kMaxRate);
+	const float right = yawRateSetpoint(0.5f, kDeadzone, kMaxRate);
+
+	// a value saved while the loop was closed does not outlive the loop opening
+	holdStick(hold, rate_control, centred, -0.1f, 250);
+	EXPECT_EQ(hold.update(right, kDeadzone, rate_control), Event::Deflected);
+	rate_control.resetIntegral();
+	hold.reset();
+
+	// the loop closes again with the stick already out: a deflection from zero, and zero is what comes back
+	EXPECT_EQ(hold.update(right, kDeadzone, rate_control), Event::Deflected);
+	holdStick(hold, rate_control, right, 0.f, 250);
+	EXPECT_GT(rate_control.getIntegral(2), 0.f);
+	EXPECT_EQ(hold.update(centred, kDeadzone, rate_control), Event::Released);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), 0.f);
+}
