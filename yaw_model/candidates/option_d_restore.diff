+TEST(RateControlTest, SetIntegralIsClampedAndOutputNextCycle)
+{
+	RateControl rate_control;
+	rate_control.setIntegratorLimit(Vector3f(0.f, 0.f, 0.3f));
+	rate_control.setIntegral(2, 0.1f);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), 0.1f);
+	// the integral term is output as is: zero error, zero gains
+	EXPECT_FLOAT_EQ(rate_control.update(Vector3f(), Vector3f(), Vector3f(), 0.004f, false)(2), 0.1f);
+	rate_control.setIntegral(2, -0.5f);	// beyond the limit: clamped to it
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), -0.3f);
+	EXPECT_FLOAT_EQ(rate_control.update(Vector3f(), Vector3f(), Vector3f(), 0.004f, false)(2), -0.3f);
+	rate_control.setIntegral(2, NAN);	// not finite: ignored
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), -0.3f);
+	EXPECT_FLOAT_EQ(rate_control.update(Vector3f(), Vector3f(), Vector3f(), 0.004f, false)(2), -0.3f);
+	rate_control.setIntegral(3, 0.2f);	// no such axis: nothing changes, and it reads as zero
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(2), -0.3f);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(3), 0.f);
+	EXPECT_FLOAT_EQ(rate_control.update(Vector3f(), Vector3f(), Vector3f(), 0.004f, false)(2), -0.3f);
+	// the other axes were never touched
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(0), 0.f);
+	EXPECT_FLOAT_EQ(rate_control.getIntegral(1), 0.f);
+}
