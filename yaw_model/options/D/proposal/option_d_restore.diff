 /**
+ * The yaw stick left the centre band this cycle: the rate setpoint is not zero
+ * and was zero on the previous closed-loop cycle.
+ */
+inline bool yawStickDeflected(float yaw_rate_sp, float yaw_rate_sp_prev)
+{
+	return yaw_rate_sp != 0.f && yaw_rate_sp_prev == 0.f;
+}
+
+/**
+ * The yaw stick came back into the centre band this cycle (yawRateSetpoint()
+ * is exactly zero there), or crossed it between two samples. A crossing counts
+ * only with a deadzone: without one a stick that dithers about the centre
+ * would change sign on every sample, and with MAN_DEADZONE 0 only an exactly
+ * centred stick is a release.
+ */
+inline bool yawStickReleased(float yaw_rate_sp, float yaw_rate_sp_prev, float deadzone)
+{
+	return (yaw_rate_sp == 0.f && yaw_rate_sp_prev != 0.f)
+	       || (deadzone > 0.f && yaw_rate_sp * yaw_rate_sp_prev < 0.f);
+}
