+TEST(AirshipManualInputTest, StickEventsAreTheDeadzoneEdges)
+{
+	const float out = yawRateSetpoint(0.5f, kDeadzone, kMaxRate);
+	const float in = yawRateSetpoint(0.05f, kDeadzone, kMaxRate);
+	const float back = yawRateSetpoint(-0.5f, kDeadzone, kMaxRate);
+
+	EXPECT_TRUE(yawStickDeflected(out, in));
+	EXPECT_FALSE(yawStickDeflected(out, out));
+	EXPECT_FALSE(yawStickDeflected(in, in));
+	EXPECT_TRUE(yawStickReleased(in, out, kDeadzone));
+	EXPECT_FALSE(yawStickReleased(in, in, kDeadzone));
+	EXPECT_FALSE(yawStickReleased(out, out, kDeadzone));
+	// a reversal that skips the band is a release, and not a new deflection
+	EXPECT_TRUE(yawStickReleased(back, out, kDeadzone));
+	EXPECT_FALSE(yawStickDeflected(back, out));
+	// the band edge itself is centred
+	EXPECT_TRUE(yawStickReleased(yawRateSetpoint(-kDeadzone, kDeadzone, kMaxRate), back, kDeadzone));
+	// without a deadzone a sign change is dither about the centre, not a release
+	EXPECT_FALSE(yawStickReleased(yawRateSetpoint(-0.001f, 0.f, kMaxRate), yawRateSetpoint(0.001f, 0.f, kMaxRate), 0.f));
+	EXPECT_TRUE(yawStickReleased(yawRateSetpoint(0.f, 0.f, kMaxRate), yawRateSetpoint(0.001f, 0.f, kMaxRate), 0.f));
+}
